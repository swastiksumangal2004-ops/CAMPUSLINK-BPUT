# Local demo registration keys. Replace these before any shared deployment.
CAMPUSLINK_RECRUITER_SIGNUP_KEY=recruiter123
CAMPUSLINK_ADMIN_SIGNUP_KEY=admin123
DATABASE_URL=sqlite:///./campuslink.db

# Optional licensed Internshala or regional JSON/RSS feed connector URL.
# The public Internshala site does not provide a stable unauthenticated API.
# CAMPUSLINK_INTERNSHALA_FEED_URL=

# Groq API key (keep blank here and set the real secret in the local .env).
# Without a key, CampusLink returns local role-specific guidance.
GROQ_API_KEY=
# Optional compatibility key; GROQ_API_KEY takes precedence.
# CAMPUSLINK_AI_API_KEY=
CAMPUSLINK_AI_MODEL=openai/gpt-oss-120b
CAMPUSLINK_AI_API_BASE=https://api.groq.com/openai/v1

# Set APP_ENV=production and configure a strong secret for deployments.
# APP_ENV=development
# JWT_SECRET_KEY=
